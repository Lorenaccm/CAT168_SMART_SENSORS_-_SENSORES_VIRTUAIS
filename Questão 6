%% Questao 6 - CAT168 (UFOP) - Classificacao de Pureza de Oleo com PMC
clear; clc;

% 1. Leitura dos dados de treinamento e teste (dadosTrafos.xlsx)
raw_treino = readcell('dadosTrafos.xlsx', 'Sheet', 'tab_treinamento');
raw_teste  = readcell('dadosTrafos.xlsx', 'Sheet', 'tab_teste');

% Converter strings com virgula decimal para matriz numerica
dados_treino = zeros(30, 4);
for i = 1:30
    linha = strrep(string(raw_treino{i+1, 1}), ',', '.');
    dados_treino(i, :) = sscanf(linha, '%f')';
end

dados_teste = zeros(10, 3);
for i = 1:10
    linha = strrep(string(raw_teste{i+1, 1}), ',', '.');
    dados_teste(i, :) = sscanf(linha, '%f')';
end

X_train = dados_treino(:, 1:3);
d_train = dados_treino(:, 4);
X_test  = dados_teste(:, 1:3);

% 2. Executar dois treinamentos (T1 e T2) com sementes diferentes
[W1_T1, b1_T1, W2_T1, b2_T1, ep1, eqm1] = treinar_pmc(X_train, d_train, 4, 0.05, 1e-6, 10);
[W1_T2, b1_T2, W2_T2, b2_T2, ep2, eqm2] = treinar_pmc(X_train, d_train, 4, 0.05, 1e-6, 99);

fprintf('--- RESULTADOS DO TREINAMENTO ---\n');
fprintf('T1: %d epocas | EQM final: %.6f\n', ep1, eqm1);
fprintf('T2: %d epocas | EQM final: %.6f\n\n', ep2, eqm2);

disp('Pesos Camada Oculta W1 (T1) e Bias b1 (T1):'); disp([W1_T1, b1_T1]);
disp('Pesos Camada Saida W2 (T1) e Bias b2 (T1):');  disp([W2_T1, b2_T1]);

disp('Pesos Camada Oculta W1 (T2) e Bias b1 (T2):'); disp([W1_T2, b1_T2]);
disp('Pesos Camada Saida W2 (T2) e Bias b2 (T2):');  disp([W2_T2, b2_T2]);

% 3. Classificacao das 10 amostras de teste
[y_cont1, y_cls1] = classificar_pmc(X_test, W1_T1, b1_T1, W2_T1, b2_T1);
[y_cont2, y_cls2] = classificar_pmc(X_test, W1_T2, b1_T2, W2_T2, b2_T2);

Tabela_Teste = table((1:10)', X_test(:,1), X_test(:,2), X_test(:,3), ...
    y_cont1, y_cls1, y_cont2, y_cls2, ...
    'VariableNames', {'Amostra', 'X1', 'X2', 'X3', 'Saida_T1', 'Classe_T1', 'Saida_T2', 'Classe_T2'});
disp('--- CLASSIFICACAO DAS AMOSTRAS DE TESTE ---');
disp(Tabela_Teste);

%% Funcoes Auxiliares
function [W1, b1, W2, b2, epoca, eqm] = treinar_pmc(X, d, n_oculta, eta, tol, seed)
    rng(seed);
    [N, n_in] = size(X);
    
    % Inicializacao aleatoria entre 0 e 1 (Item a)
    W1 = rand(n_oculta, n_in);
    b1 = rand(n_oculta, 1);
    W2 = rand(1, n_oculta);
    b2 = rand(1, 1);
    
    eqm_ant = inf;
    max_epocas = 50000;
    
    for epoca = 1:max_epocas
        soma_eq = 0;
        for i = 1:N
            x = X(i, :)';
            target = d(i);
            
            % Propagacao direta (Forward)
            u1 = W1 * x + b1;
            y1 = tanh(u1);
            u2 = W2 * y1 + b2;
            y2 = tanh(u2);
            
            erro = target - y2;
            soma_eq = soma_eq + 0.5 * (erro^2);
            
            % Retropropagacao (Backward)
            delta2 = erro * (1 - y2^2);
            delta1 = (W2' * delta2) .* (1 - y1.^2);
            
            % Atualizacao de pesos e bias
            W2 = W2 + eta * (delta2 * y1');
            b2 = b2 + eta * delta2;
            W1 = W1 + eta * (delta1 * x');
            b1 = b1 + eta * delta1;
        end
        
        eqm = soma_eq / N;
        if abs(eqm - eqm_ant) <= tol
            return;
        end
        eqm_ant = eqm;
    end
end

function [y_cont, y_cls] = classificar_pmc(X, W1, b1, W2, b2)
    N = size(X, 1);
    y_cont = zeros(N, 1);
    y_cls  = zeros(N, 1);
    for i = 1:N
        x = X(i, :)';
        y1 = tanh(W1 * x + b1);
        y2 = tanh(W2 * y1 + b2);
        y_cont(i) = y2;
        if y2 >= 0
            y_cls(i) = 1;
        else
            y_cls(i) = -1;
        end
    end
end
